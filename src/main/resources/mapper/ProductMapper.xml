<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.javaup.ai.products.mapper.ProductMapper">
    <resultMap id="ProductResultMap" type="org.javaup.ai.products.domain.Product">
        <id property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="categoryId" column="category_id"/>
        <result property="mainImageUrl" column="main_image_url"/>
        <result property="otherImageUrls" column="other_image_urls"/>
        <result property="description" column="description"/>
        <result property="price" column="price"/>
        <result property="originalPrice" column="original_price"/>
        <result property="stockQuantity" column="stock_quantity"/>
        <result property="isActive" column="is_active"/>
        <result property="purchaseLinks" column="purchase_links"/>
        <result property="productDetails" column="product_details"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <insert id="insertProduct" parameterType="org.javaup.ai.products.domain.Product">
        INSERT INTO products (
        product_name, category_id, main_image_url, other_image_urls,
        description, price, original_price, stock_quantity,
        is_active, purchase_links, product_details
        )
        VALUES (
        #{productName}, #{categoryId}, #{mainImageUrl}, #{otherImageUrls},
        #{description}, #{price}, #{originalPrice}, #{stockQuantity},
        #{isActive}, #{purchaseLinks}, #{productDetails}
        )
        <selectKey keyProperty="productId" resultType="int" order="AFTER">
            SELECT LAST_INSERT_ID()
        </selectKey>
    </insert>

    <update id="updateProduct" parameterType="org.javaup.ai.products.domain.Product">
        UPDATE products
        SET product_name = #{productName},
            category_id = #{categoryId},
            main_image_url = #{mainImageUrl},
            other_image_urls = #{otherImageUrls},
            description = #{description},
            price = #{price},
            original_price = #{originalPrice},
            stock_quantity = #{stockQuantity},
            is_active = #{isActive},
            purchase_links = #{purchaseLinks},
            product_details = #{productDetails}
        WHERE product_id = #{productId}
    </update>

    <delete id="deleteProduct" parameterType="int">
        DELETE FROM products WHERE product_id = #{productId}
    </delete>

    <select id="selectProductById" parameterType="int" resultMap="ProductResultMap">
        SELECT * FROM products WHERE product_id = #{productId}
    </select>

    <select id="selectAllProducts" resultMap="ProductResultMap">
        SELECT * FROM products
    </select>

    <select id="selectProductsByCategoryId" parameterType="int" resultMap="ProductResultMap">
        SELECT * FROM products WHERE category_id = #{categoryId}
    </select>

    <select id="selectProductsByName" parameterType="string" resultMap="ProductResultMap">
        SELECT * FROM products WHERE product_name LIKE CONCAT('%', #{productName}, '%')
    </select>
</mapper>